<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- Sin base de datos: siempre se ejecutan. -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Contra MySQL/MariaDB: necesitan TEST_DB_HOST, TEST_DB_NAME, TEST_DB_USER y TEST_DB_PASS.
             La base indicada se VACÍA en cada ejecución: nunca apuntes a una base real. -->
        <testsuite name="integracion">
            <directory>tests/Integracion</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
