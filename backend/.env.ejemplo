# Copia este fichero a `.env` y rellénalo con los datos de hPanel
# (Bases de datos → MySQL). El `.env` real no se sube a ningún repositorio.

# Host de MySQL. En Hostinger casi siempre es 'localhost'.
DB_HOST=localhost
DB_NAME=u123456789_apperp
DB_USER=u123456789_adminerp
DB_PASS=

# Clave de cifrado y de sesión. 64 caracteres aleatorios.
# Genérala con:  php -r "echo bin2hex(random_bytes(32));"
# Cambiarla invalida los tokens de Google Calendar guardados, salvo que estén
# re-cifrados antes con la clave anterior.
APP_SECRET=

# URL pública de la aplicación, sin barra final. Ej: https://erp.miempresa.com
# Vacía: el enlace de contraseña, la redirección de Google y el cron se
# construirán con la cabecera Host de la petición.
APP_URL=

# Orígenes del front (React) que pueden llamar a la API con cookies, separados
# por comas y sin barra final. http://localhost:5173 (Vite) ya va incluido.
# OBLIGATORIO si el front no está en localhost: sin esto el navegador rechaza
# el preflight y el login falla con «blocked by CORS policy».
# Ej: CORS_ORIGINS=https://erp.miempresa.com
CORS_ORIGINS=

# Cookie de sesión.
#
# COOKIE_SAMESITE: Lax (por defecto) vale cuando front y API comparten SITIO, es
#   decir subdominios del mismo dominio (erp.miempresa.com + api.miempresa.com)
#   o el mismo host con puertos distintos (localhost:5173 + localhost:8000).
#   Solo si el front está en OTRO dominio registrable pon None, que exige HTTPS
#   en la API: el navegador descarta una cookie None sin Secure.
COOKIE_SAMESITE=Lax

# COOKIE_DOMAIN: a qué dominio se ata la cookie de sesión.
#   Vacío (por defecto): la cookie va solo al host que la emite. Correcto si el
#   front y la API son el mismo host, y en desarrollo con localhost.
#   Si el front y la API son SUBDOMINIOS DISTINTOS del mismo dominio, pon el
#   dominio con punto inicial: .miempresa.com. Sin esto el navegador no manda la
#   cookie de la API al front y el login responde 419 aunque SameSite esté bien.
#   Con subdominios del mismo registrable, Lax sigue siendo el valor correcto.
#   No lo pongas si el front y la API comparten host, ni si el dominio no contiene
#   el de la API: entonces la cookie se descarta y el login falla en silencio.
#   Ej: COOKIE_DOMAIN=.miempresa.com
COOKIE_DOMAIN=

# Ruta del fichero de clave de la bóveda (opcional). Vacío: el directorio padre
# del público (ej. /home/USUARIO/domains/SUBDOMINIO/.croilab-boveda).
BOVEDA_CLAVE_FICHERO=

# Dónde se guardan las sesiones: files (por defecto) o db (tabla `sessions`).
# Con db, varios servidores detrás de un balanceador comparten las sesiones.
SESSION_DRIVER=files

# Clave de la bóveda (cifra los tokens de Google) en la configuración, en vez de
# en un fichero en disco. Formato: id=64 caracteres hexadecimales, la vigente
# primero y separadas por comas. Ej: BOVEDA_CLAVE=k2=…,k1=…
# Vacía: se usa el fichero .croilab-boveda (o BOVEDA_CLAVE_FICHERO).
BOVEDA_CLAVE=

# ---------- Correo (recuperar contraseña) ----------
# URL pública del front, sin barra final: los enlaces de los correos apuntan
# aquí. Se configura a mano a propósito (nunca se toma de la cabecera Host,
# que la elige quien hace la petición).
FRONT_URL=https://app.miempresa.com

# smtp (por defecto) o archivo (desarrollo: deja cada correo como .eml en MAIL_DIR)
MAIL_DRIVER=smtp
SMTP_HOST=smtp.hostinger.com
# tls = STARTTLS (puerto 587) · ssl = SSL directo (puerto 465) · none = sin cifrar
SMTP_SEGURIDAD=ssl
SMTP_PORT=465
SMTP_USER=no-responder@miempresa.com
SMTP_PASS=
MAIL_FROM=no-responder@miempresa.com
MAIL_FROM_NOMBRE=Croilab
MAIL_DIR=
